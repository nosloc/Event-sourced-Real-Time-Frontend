GET http://127.0.0.1:9000/api/hello
###
GET http://127.0.0.1:9000/api/therapists
###
GET http://127.0.0.1:9000/api/therapists/dev
###
GET http://127.0.0.1:9000/api/companies
Authorization: Bearer ac709fa8-aee3-4e87-b120-14c2c410873a
###
# Dev Company: its id is fixed (DevAccount)
GET http://127.0.0.1:9000/api/companies/af7d48a9-d8cf-324f-9b52-404fdb61eb25
Authorization: Bearer ac709fa8-aee3-4e87-b120-14c2c410873a
###
GET http://127.0.0.1:9000/api/therapists/dev/appointments
Authorization: Bearer ac709fa8-aee3-4e87-b120-14c2c410873a
###
# Expected now: 404 (unknown therapist; needs a token, see the section below)
GET http://127.0.0.1:9000/api/therapists/zzz/appointments
###
POST http://127.0.0.1:9000/api/login
Content-Type: application/json

{
  "username": "dev"
}
###
POST http://127.0.0.1:9000/api/login
Content-Type: application/json

{
  "username": "xxx"
}

###
# ---- Create / delete an appointment (run in order: create, delete) ----
# Timestamps are epoch seconds: 1791792000 = 2026-10-12 10:00 Zurich (UTC+2).
# Uses the hardcoded dev token from AuthMiddleware (to be removed, see notes/progress.md).
@token = ac709fa8-aee3-4e87-b120-14c2c410873a

# Expected: 201 + the created appointment
# @name create
POST http://127.0.0.1:9000/api/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{ 
  "timeRange": { "start": 1791792000, "end": 1791799200 }, 
  "therapistIds": ["dev"],
  "patientIds": [],
  "appointmentType": "INDIVIDUAL"
}

###
@appointmentId = {{create.response.body.$.appointment.appointmentId}}

# Expected: 204
DELETE http://127.0.0.1:9000/api/appointments/{{appointmentId}}
Authorization: Bearer {{token}}

###
# Expected: 404 TherapistsNotFound (unknown therapist)
POST http://127.0.0.1:9000/api/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{ 
  "timeRange": { "start": 1791792000, "end": 1791799200 },
  "therapistIds": ["zzz"],
  "patientIds": [],
  "appointmentType": "INDIVIDUAL"
}

###
# ---- Create a company, then a therapist in it (run in order) ----

# Expected: 201 + the created company
# @name createCompany
POST http://127.0.0.1:9000/api/companies
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Test Clinic", "address": { "street": "Test Street", "number": "1", "city": "Testville", "state": "VD" } }

###
@companyId = {{createCompany.response.body.$.companyId}}

# Expected: 201 + the created therapist (a second run returns 409, the trigram is taken)
POST http://127.0.0.1:9000/api/therapists
Authorization: Bearer {{token}}
Content-Type: application/json

{ "firstName": "New", "lastName": "Therapist", "therapistId": "ntp", "companyId": "{{companyId}}", "role": "PSYCHOLOGIST" }

###
# Expected: 404 CompanyNotFound (unknown company)
POST http://127.0.0.1:9000/api/therapists
Authorization: Bearer {{token}}
Content-Type: application/json

{ "firstName": "No", "lastName": "Company", "therapistId": "nco", "companyId": "00000000-0000-4000-8000-000000000000", "role": "PSYCHOLOGIST" }


###
# exppected: 201 + the created patient
POST http://127.0.0.1:9000/api/patients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "dateOfBirth": "1990-01-01"
}

###
# expected: 200 + the created patient
GET http://127.0.0.1:9000/api/patients/<UUID of the created patient>
Authorization: Bearer {{token}}

###
# expected: 200 + the list of patients
GET http://127.0.0.1:9000/api/patients
Authorization: Bearer {{token}}

###
# ---- Dashboards (replace <company id> with an id from GET /api/companies) ----
# expected: 200 + the directory figures of the company
GET http://127.0.0.1:9000/api/companies/1ce778ab-5911-434e-a769-5e2098d717a7/dashboards/directory
Authorization: Bearer {{token}}

###
# expected: 200 + the activity figures of the week that contains the date
GET http://127.0.0.1:9000/api/companies/1ce778ab-5911-434e-a769-5e2098d717a7/dashboards/activity?unit=WEEK&date=2026-10-12
Authorization: Bearer {{token}}

###
# expected: 200 + the activity figures of the month that contains the date
GET http://127.0.0.1:9000/api/companies/1ce778ab-5911-434e-a769-5e2098d717a7/dashboards/activity?unit=MONTH&date=2026-10-12
Authorization: Bearer {{token}}

###
# expected: 200 + the billing figures of the company
GET http://127.0.0.1:9000/api/companies/1ce778ab-5911-434e-a769-5e2098d717a7/dashboards/billing
Authorization: Bearer {{token}}

###
# expected: 404 (unknown company)
GET http://127.0.0.1:9000/api/companies/00000000-0000-4000-8000-000000000000/dashboards/directory
Authorization: Bearer {{token}}

###
# ---- Demo data ----
# Run it first, on a fresh database that only holds the dev account (the
# requests above create a therapist, after which it answers 409).
# Expected: 200 + the counts of what was generated and the duration; a second
# call returns 409 DemoDataAlreadyGenerated
POST http://127.0.0.1:9000/api/demo-data
Authorization: Bearer {{token}}

###
# ---- Event store ----
# expected: 200 + the 10 newest events (oldest first) and the total
GET http://127.0.0.1:9000/api/events/latest?take=10
Authorization: Bearer {{token}}

###
# expected: 200 + the 10 oldest events after skipping 20, and the total
GET http://127.0.0.1:9000/api/events?skip=20&take=10
Authorization: Bearer {{token}}
